# Copy to .env (next to your project.json, or in the directory you run from) and fill in.
# .env is git-ignored. Values are never printed by the tools.

# OpenAI-compatible endpoint (no trailing /v1). Any gateway that speaks /v1/images/edits
# and/or /v1/chat/completions with image output works.
PXF_API_BASE=https://api.example.com
PXF_API_KEY=

# Model for the "images" engine: POST /v1/images/edits (multipart). An image-edit model.
PXF_IMAGE_MODEL=

# Model for the "chat" engine: POST /v1/chat/completions with "modalities": ["image", "text"].
# A chat model that returns images (e.g. a Gemini image model behind a compatible gateway).
PXF_CHAT_IMAGE_MODEL=

# Optional: override the project's "engine" ("chat" or "images").
# PXF_ENGINE=chat

# Optional: the pxf binary (default: pxf on PATH, then target/release/pxf[.exe]).
# PXF_BIN=

# Optional: Aseprite, for the hand-edit round trip (python -m pxf_pipeline asebridge).
# ASEPRITE=
