      25,
      2
    ],
    "222": [
      3,
      10,
      0,
      0
    ]
  },
  "bake": {
    "name": "char_form_beach.spr",
    "shared": [
      "char_form_alt.spr"
    ],
    "town": {
      "archive": "game/char_town.ark",
      "src": "char_form_town.spr",
      "name": "char_form_beach_town.spr"
    }
  }
