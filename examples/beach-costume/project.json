{
  "work": "work",
  "source_archive": "game/pristine/char.ark",
  "target_archive": "game/char.ark",
  "sheet": "char_form.spr",
  "ani": "char_form.ani",
  "per": 50,
  "scale": 5,
  "gap": 8,
  "bg": "808080",
  "canvas": 1024,
  "refs": [
    "src",
    "skin_ref.png"
  ],
  "downscale_flags": [
    "--tol",
    "24",
    "--resolve",
    "--grain",
    "--register",
    "--metric",
    "redmean"
  ],
  "prompt_file": "prompt.txt",
  "engine": "chat",
  "leftover_max": 28,
  "tries": 3,
  "mask_grow": 4,
  "hooks": {
    "crops": "bodymask.py:crops",
    "masks": "hooks.py:masks",
